{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "AgenticSdlc": {
    "Llm": {
      "Provider": "Auto",
      "Model": "claude-sonnet-5",
      "MaxTokens": 8000,
      "MaxJsonRetries": 2,
      "MaxContextCharsPerArtifact": 8000
    },
    "Orchestration": {
      "MaxParallelNodes": 3,
      "DefaultNodeTimeoutSeconds": 300,
      "MaxAttempts": 3,
      "RetryBaseDelaySeconds": 5,
      "ClarificationMaxRounds": 2
    },
    "Persistence": {
      "DbPath": "data/agentic.db"
    },
    "Workspace": {
      "Root": "workspaces",
      "SamplesRoot": "samples"
    }
  }
}
